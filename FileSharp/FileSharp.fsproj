<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="extensions.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="Modules/ConfigurationRetrieval.fs" />
    <Compile Include="Modules/ExtensionData.fs" />
    <Compile Include="Modules/DirectoryAndFileFunctions.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
