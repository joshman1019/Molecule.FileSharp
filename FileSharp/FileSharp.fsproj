<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>filesharp</ToolCommandName>
    <PackageId>Molecule.FileSharp</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Cross-platform directory organization and maintenance tools.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <Content Include="extensions.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="Modules/ConfigurationRetrieval.fs" />
    <Compile Include="Modules/ExtensionData.fs" />
    <Compile Include="Modules/DirectoryAndFileFunctions.fs" />
    <Compile Include="Modules/Cli.fs" />
    <Compile Include="Modules/ConsoleUi.fs" />
    <Compile Include="Modules/Maintenance.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
